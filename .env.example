# Copia este archivo como .env y ajusta los valores.
# El .env real NO se sube a git.

# Credenciales que usa docker-compose para crear la base de datos
POSTGRES_USER=remates
POSTGRES_PASSWORD=remates
POSTGRES_DB=remates

# Conexión que usará el backend (puerto 5433 del host -> 5432 del contenedor)
DATABASE_URL=postgresql+psycopg://remates:remates@localhost:5433/remates
